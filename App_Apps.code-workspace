{
  "folders": [
    {
      "name": "App_Apps",
      "path": "."
    },
    {
      "name": "Base_Core",
      "path": "../Base_Core"
    },
    {
      "name": "Base_Qt",
      "path": "../Base_Qt"
    },
    {
      "name": "Devices",
      "path": "../Devices"
    }
  ],
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
      "name": "Reusable debug",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
	    "cwd": "${workspaceFolder:App_Apps}",
	    "env": { "PYTHONPATH": "${workspaceFolder:App_Apps}" },
      "python": "${workspaceFolder:App_Apps}/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    } 
    ]
  },
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder:App_Apps}/.venv/Scripts/python.exe",
    "python.analysis.indexing": true,
    "python.analysis.autoImportCompletions": true,
    "python.analysis.extraPaths": [
      "${workspaceFolder:Base_Core}",
      "${workspaceFolder:Base_Qt}",
      "${workspaceFolder:Devices}"
    ],
    "python.analysis.useLibraryCodeForTypes": true,
    "python.analysis.packageIndexDepths": [
      { "name": "PySide6", "depth": 6, "includeAllSymbols": true },
      { "name": "shiboken6", "depth": 3, "includeAllSymbols": true },
      { "name": "base_core", "depth": 5, "includeAllSymbols": true },
      { "name": "base_qt", "depth": 8, "includeAllSymbols": true },
    ]
  }
}
